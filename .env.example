# Copy to .env and fill in. All three are public client values (safe in the app bundle).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
EXPO_PUBLIC_FLAGSMITH_CLIENT_KEY=your-flagsmith-environment-key
# Public web address used in invite links (the deployed web app)
EXPO_PUBLIC_WEB_URL=https://YOUR-USER.github.io/wedora
